# =====================================================================
# Swift Shop 环境变量样例 — 复制为 .env 后按需修改
#   cp .env.example .env
# 生产必改：JWT_SECRET / DATABASE_URL / ADMIN_DEFAULT_PASSWORD / SMTP_*
# =====================================================================

# --- App ---
ENV=dev                          # dev | prod (prod 关闭 /docs 与 mock 支付)
DEBUG=true
APP_NAME=Shop
API_V1_PREFIX=/api/v1

# --- Database ---
# 开发默认 SQLite（零基建启动）；生产用 PostgreSQL：
# DATABASE_URL=postgresql+asyncpg://shop:CHANGE_ME@localhost:5432/shop
DATABASE_URL=sqlite+aiosqlite:///./shop_dev.db

# --- KV 抽象（验证码 / 冷却 / 限流）---
KV_BACKEND=memory                # memory（单进程 dev） | pg（跨进程持久化）

# --- Security（生产必改！）---
JWT_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_MIN=30
REFRESH_TOKEN_DAYS=14
# 对外可访问的后端地址（Mock 收银台跳转链接用它拼接）
BACKEND_PUBLIC_URL=http://localhost:8000

# --- 前端来源（CORS）---
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ORIGINS_STR=http://localhost:5173,http://localhost:5174,http://localhost:8000

# --- Mail（dev 指向 Mailpit :1025；生产填真实 SMTP）---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@shop-dev.com
MAIL_FROM_NAME=Swift Shop

# --- 对象存储：local（开发默认）或 s3（MinIO/云 OSS）---
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=shop
S3_PUBLIC_URL=http://localhost:9000/shop

# --- Google OAuth（不填则 /auth/google 返回 501）---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/google/callback

# --- 支付适配层（当前仅实现 mock）---
PAYMENT_PROVIDER=mock            # mock | stripe | alipay | wechat（预留）
PAYMENT_CURRENCY=CNY
PAYMENT_WEBHOOK_SECRET=          # 留空回退 JWT_SECRET

# --- 首次启动种子数据 ---
ADMIN_EMAIL=admin@shop-dev.com
ADMIN_DEFAULT_PASSWORD=Admin#12345
SEED_DEMO_PRODUCTS=true
